# Keep host build artifacts and local cruft out of the Docker build context so the image
# restores/publishes cleanly and reproducibly.
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/*.user

# Frontend (built inside its own image later)
frontend/node_modules/
frontend/dist/

# Local env / git / docs — not needed to build the API image
.env
.git/
.github/
tests/
