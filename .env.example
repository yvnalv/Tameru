# Copy to .env and fill in. NEVER commit real secrets (docs/SECURITY.md).

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_USER=tameru
POSTGRES_PASSWORD=tameru_dev
POSTGRES_DB=tameru

# --- API configuration (bound via ASP.NET Core config; double underscore = nesting) ---
# Connection string used by the API to reach the database above.
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=tameru;Username=tameru;Password=tameru_dev

# JWT signing secret (M1+). Use a long random value in real environments.
Jwt__SigningKey=change-me-in-a-real-environment-please
Jwt__AccessMinutes=15
Jwt__RefreshDays=14

# Dev startup behavior (M1+).
Database__AutoMigrate=true
Seed__Enabled=true

# Allowed SPA origin(s) for CORS.
Cors__AllowedOrigins__0=http://localhost:5173
