# Copy to .env and fill in. NEVER commit real secrets (docs/SECURITY.md).
# Consumed by docker-compose.yml (the full web → api → db stack).

# --- Deployment ---
# Use Production on a server (turns off Swagger; the app reads config from these env vars).
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL ---
POSTGRES_USER=tameru
POSTGRES_DB=tameru
# Use a strong password in production.
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Auth (JWT) ---
# A long random secret (e.g. `openssl rand -base64 48`). Required in production.
Jwt__SigningKey=change-me-in-a-real-environment-please-use-a-long-random-value

# --- Owner account (seeded on first run only) ---
SEED_OWNER_EMAIL=you@example.com
SEED_OWNER_PASSWORD=change-me-strong-owner-password
SEED_OWNER_DISPLAY_NAME=Yovan
SEED_OWNER_LOCALE=en

# --- Networking ---
# The SPA calls same-origin /api (Nginx proxies it), so the CORS origin is your site's URL.
CORS_ORIGIN=https://tameru.example.com
# Host ports published by docker-compose.
WEB_PORT=8091
API_PORT=8090
