# Multi-stage build for the Tameru API (.NET 8). See docs/DEPLOYMENT.md.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Restore (leverage layer caching on the project/solution files first).
COPY Directory.Build.props ./
COPY Tameru.sln ./
COPY src/ ./src/
RUN dotnet restore src/Bootstrapper/Tameru.Api/Tameru.Api.csproj

# Publish.
RUN dotnet publish src/Bootstrapper/Tameru.Api/Tameru.Api.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "Tameru.Api.dll"]
